@style
.painel { max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem; }
.painel-topo { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
.painel h1 { font-size: 2rem; }
.painel-cartao { padding: 1.6rem; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); }
.painel dl { display: grid; grid-template-columns: max-content 1fr; gap: .6rem 1.4rem; }
.painel dt { color: var(--muted); }
@endstyle

